/* Pill overlay rendered inside mx_CallView; mirrors the look of the legacy
   primary-tile mic indicator (see _VideoFeed.pcss). Sits above the AppTile
   so it overlays on top of the Element Call widget iframe. */
.mx_CallMicIndicator {
    /* This element is rendered into document.body via React.createPortal so it
       sits in the same stacking context as the Element Call widget iframe (which
       PersistedElement also mounts at body level with z-index: 9). Inline
       `top` / `left` are set from JS to track the .mx_CallView bounding rect. */
    position: fixed;
    z-index: 10;
    display: flex;
    gap: 6px;
    pointer-events: none; /* purely informational; never steals widget clicks */
}

.mx_CallMicIndicator_pill {
    width: 24px;
    height: 24px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background-color: rgb(0, 0, 0, 0.5); /* Same on both themes */
    border-radius: 100%;
    transition:
        background-color 0.12s ease-out,
        box-shadow 0.12s ease-out;

    svg {
        width: 16px;
        height: 16px;
        color: white; /* Same on both themes */
    }

    /* Highlight the pill when the corresponding stream is muted. Reuses the
       same red used by other muted-state UI in the app so the meaning carries
       without needing a legend. */
    &[data-muted] {
        background-color: $alert;
    }

    /* Mirrors the legacy primary-tile pulse from _VideoFeed.pcss: a green ring
       expanding out of the pill while the local participant is speaking. Driven
       by `data-speaking` on the mic pill only (CallEvent.SpeakingState gated by
       !micMuted). */
    &[data-speaking="true"] {
        background-color: #00b06b; /* Same on both themes; readable on dark and light feed bg */
        animation: mx_CallMicIndicator_pulse 1.4s ease-out infinite;
    }
}

/* Pulse: start with a solid green ring at full opacity, expand and fade out.
   Ported from `mx_VideoFeed_mic_pulse` so the host-side indicator matches the
   legacy primary-tile feel. */
@keyframes mx_CallMicIndicator_pulse {
    0% {
        box-shadow: 0 0 0 0 rgb(0, 176, 107, 0.7);
    }
    100% {
        box-shadow: 0 0 0 12px rgb(0, 176, 107, 0);
    }
}
